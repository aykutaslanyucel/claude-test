# Railway Environment Variables Template
# Copy these to your Railway service variables

# ======================
# BACKEND SERVICE
# ======================

# Application
NODE_ENV=production
PORT=3001

# Database (automatically set by Railway)
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis (automatically set by Railway)
# REDIS_URL=${{Redis.REDIS_URL}}

# Authentication (GENERATE SECURE SECRETS!)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_32_CHARS_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_SECURE_RANDOM_STRING
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AI Services
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Storage (configure after deployment)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=legaldd-documents-prod

# CORS (set after frontend deployment)
FRONTEND_URL=https://your-frontend-url.railway.app

# Logging
LOG_LEVEL=info

# ======================
# FRONTEND SERVICE
# ======================

# Application
NODE_ENV=production

# API URL (set after backend deployment)
NEXT_PUBLIC_API_URL=https://your-backend-url.railway.app/api

# ======================
# NOTES
# ======================
# 1. DATABASE_URL and REDIS_URL are automatically set by Railway
#    Use the format: ${{Postgres.DATABASE_URL}} in Railway UI
#
# 2. Generate secure secrets:
#    openssl rand -base64 32
#
# 3. Get Anthropic API key:
#    https://console.anthropic.com
#
# 4. Set FRONTEND_URL after frontend deploys
#    Set NEXT_PUBLIC_API_URL after backend deploys
#
# 5. For S3, you can use Railway volumes initially:
#    - More info: https://docs.railway.app/reference/volumes
